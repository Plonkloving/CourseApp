<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ic_sc_today"
        android:shortcutShortLabel="@string/shortcut_today"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="com.local.courseschedule.shortcut.TODAY"
            android:targetPackage="com.local.courseschedule"
            android:targetClass="com.local.courseschedule.MainActivity">
            <extra android:name="shortcutTarget" android:value="today" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="week"
        android:enabled="true"
        android:icon="@drawable/ic_sc_week"
