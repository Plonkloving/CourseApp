            android:targetClass="com.local.courseschedule.MainActivity">
            <extra android:name="shortcutTarget" android:value="week" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="month"
        android:enabled="true"
        android:icon="@drawable/ic_sc_month"
