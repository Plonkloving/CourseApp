        android:shortcutLongLabel="@string/shortcut_month_long">
        <intent
            android:action="com.local.courseschedule.shortcut.MONTH"
            android:targetPackage="com.local.courseschedule"
            android:targetClass="com.local.courseschedule.MainActivity">
