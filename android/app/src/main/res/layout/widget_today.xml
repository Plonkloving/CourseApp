<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_today_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今天课表"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_today_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:minHeight="26dp"
        android:singleLine="true"
        android:textColor="#E6ECFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_today_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:minHeight="26dp"
        android:singleLine="true"
        android:textColor="#E6ECFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_today_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:minHeight="26dp"
        android:singleLine="true"
        android:textColor="#E6ECFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_today_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:minHeight="26dp"
        android:singleLine="true"
        android:textColor="#E6ECFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_today_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:minHeight="26dp"
        android:singleLine="true"
        android:textColor="#E6ECFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_today_row_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:minHeight="26dp"
        android:singleLine="true"
        android:textColor="#B9C8E8"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_today_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="今天没有课"
        android:textColor="#B9C8E8"
        android:textSize="12sp" />
</LinearLayout>
